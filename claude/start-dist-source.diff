         b_shape_data = if (b_shape_fixed == 1L) {
             as.numeric(rep_init(b_shape))
         } else numeric(0),
+        start_dist = start_dist,
+        start_window = as.numeric(start_window),
+        start_shape_cap = as.numeric(start_shape_cap),
         mean_log10_total0 = rep_init(mean_log10_total0),
         sd_log10_total0 = rep_init(sd_log10_total0),
         total0_anchor = total0_anchor,
@@ -510,6 +556,14 @@ archer_fit <- function(data,
         dots <- dots[!is_data_arg]
     } else if (is.list(data)) {
         stan_data <- data
+        ## Data lists saved before start_dist existed lack its three fields;
+        ## the Stan programs now require them. Fill them with the old
+        ## behaviour so those lists still fit unchanged.
+        if (is.null(stan_data$start_dist)) {
+            stan_data$start_dist <- 0L
+            stan_data$start_window <- 1
+            stan_data$start_shape_cap <- 3
+        }
     } else {
         stop("`data` must be a data frame or a Stan data list")
     }
