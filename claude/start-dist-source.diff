         ## sampling of everything else and is left in the data regardless.
     }
 
+    ## Windowed, shared starting distribution. The Stan programs make the same
+    ## checks in transformed data; repeated here so a bad call fails before
+    ## sampling starts.
+    start_dist <- as.integer(start_dist)
+    if (length(start_dist) != 1L || !start_dist %in% c(0L, 1L)) {
+        stop("`start_dist` must be 0 or 1")
+    }
+    if (start_dist == 1L) {
+        if (b_shape_fixed == 1L) {
+            stop("`start_dist = 1` has no `b_shape`: leave `b_shape` NULL")
+        }
+        if (is.null(start_window) || length(start_window) != 1L ||
+            !is.finite(start_window) || start_window <= 0 || start_window >= min_cl) {
+            stop("`start_window` must be one positive number of hours below ",
+                 "`min_cl` (", min_cl, ") when `start_dist = 1`")
+        }
+        if (length(start_shape_cap) != 1L || !is.finite(start_shape_cap) ||
+            start_shape_cap <= 1) {
+            stop("`start_shape_cap` must be one number greater than 1")
+        }
+    } else {
+        ## unused by the model; any value inside the declared bounds will do
+        start_window <- 1
+        start_shape_cap <- 3
+    }
+
     ## Same check archer_fit.stan makes, done here so it fails before compiling.
     check_erlang_window(tv, n_c = n_c, min_cl = min_cl)
 
