+                    r_lo[s:e], r_hi[s:e], m_lo[s:e], m_hi[s:e]);
+            }
 
             real mrd_i = max(abs(y_hat_i - traj[ts_idx_full[s:e], traj_id[i]])
                              ./ y_hat_i);
diff --git a/inst/stan/functions/plasmofit.stan b/inst/stan/functions/plasmofit.stan
index 69a1542..805763e 100644
--- a/inst/stan/functions/plasmofit.stan
+++ b/inst/stan/functions/plasmofit.stan
@@ -580,3 +580,157 @@ real traj_combo_partial_sum(array[] int combo_slice, int start, int end,
     }
     return lp;
 }
+
+
+/*
+ ---------------------------------------------------------------------------
+ Windowed starting distribution (start_dist = 1). Added 2026-11 for
+ plasmofit-test's claude/start-dist-design.md; everything above is
+ untouched, so start_dist = 0 runs exactly the code it ran before.
+ ---------------------------------------------------------------------------
+
+ The inoculum's ages at t = 0 follow Beta(a, b) on [0, w] in CYCLE units,
+ w = start_window / cycle_length with start_window in hours. Unlike
+ beta_starts() it does not wrap round the cycle: compartments past the
+ window get exactly zero. Age is measured from merozoite invasion, so
+ compartment i covers [(i - 1) / n_c, i / n_c] cycles.
+
+ Each compartment's mass is the Beta probability of its overlap with
+ [0, w], by 5-point Gauss-Legendre over that overlap. Tested against exact
+ pbeta differences (plasmofit-test, _scripts/start-dist-validate.R,
+ 2026-11-18): exact to machine precision at integer shapes (1, 2, 3), and at
+ worst 4e-5 in absolute compartment weight for shapes strictly between 1 and
+ 2 (7e-6 at n_c 384), where the density's edge behaviour is not polynomial. The
+ compartment straddling w is integrated over its overlap only, so the
+ result is continuous in w and therefore in cycle_length.
+
+ Requires a, b >= 1 (below 1 the density is unbounded at an edge) and
+ 0 < w < 1. The 1/w and Beta-function constants cancel in the
+ normalisation and are not computed.
+*/
+vector windowed_beta_starts(int n_c, real w, real a, real b, real total0) {
+    array[5] real gx = {-0.9061798459386640, -0.5384693101056831, 0.0,
+                        0.5384693101056831, 0.9061798459386640};
+    array[5] real lgw = {log(0.2369268850561891), log(0.4786286704993665),
+                         log(0.5688888888888889), log(0.4786286704993665),
+                         log(0.2369268850561891)};
+    real h = 1.0 / n_c;
+    vector[n_c] lcell = rep_vector(0, n_c);
+    int m = 0;                       // compartments that overlap the window
+    for (i in 1:n_c) {
+        real lo = (i - 1) * h;
+        if (lo >= w) break;
+        real hi = fmin(i * h, w);
+        real mid = 0.5 * (lo + hi);
+        real half = 0.5 * (hi - lo);
+        vector[5] lp;
+        for (k in 1:5) {
+            real x = (mid + half * gx[k]) / w;
+            lp[k] = lgw[k] + (a - 1) * log(x) + (b - 1) * log1m(x);
+        }
+        lcell[i] = log(half) + log_sum_exp(lp);
+        m = i;
+    }
+    vector[n_c] W = rep_vector(0, n_c);
+    W[1:m] = total0 * softmax(lcell[1:m]);
+    return W;
+}
+
+/*
+ make_DC() with the windowed start. The D/C construction below is a copy
+ of make_DC()'s, so the split of the start into circulating (y .* W) and
+ sequestered ((1 - y) .* W) at t = 0 is the same convention.
+*/
+vector make_DC_win(real cycle_length, int n_c, real start_window,
+                   real a, real b, real log10_total0) {
+
+    real total0 = pow(10, log10_total0);
+
+    vector[n_c] log_y = make_log_y_vals(cycle_length, n_c);
+    vector[n_c] q_v   = make_q_vals_from_log_y(n_c, log_y);
+    vector[n_c] c_k   = make_c_vals_from_log_y(n_c, log_y);
+
+    vector[n_c] W  = windowed_beta_starts(n_c, start_window / cycle_length,
+                                          a, b, total0);
+    vector[n_c] Nc = exp(log_y[1]) * (1 - q_v) .* W;   // = N_j(0)/c_j
+
+    vector[3*n_c - 1] DC;
+    for (d in 0:(n_c - 1)) {
+        DC[d + 1]             = dot_product(Nc[1:(n_c - d)], c_k[(d + 1):n_c]);
+        DC[n_c + n_c + d]     = dot_product(W[1:(n_c - d)],  c_k[(d + 1):n_c]);
+    }
+    for (d in 1:(n_c - 1))
+        DC[n_c + n_c - d]     = dot_product(W[(d + 1):n_c], c_k[1:(n_c - d)]);
+
+    return DC;
+}
+
+/* generate_starts() with the windowed start, for the matrix_exp cross-check. */
+vector generate_starts_win(real cycle_length, int n_c, real start_window,
+                           real a, real b, real log10_total0) {
+    real total0 = pow(10, log10_total0);
+    vector[n_c] y_vals = make_y_vals(cycle_length, n_c);
+    vector[n_c] wi = windowed_beta_starts(n_c, start_window / cycle_length,
+                                          a, b, total0);
+    vector[2*n_c] starts;
+    starts[1:n_c] = y_vals .* wi;
+    starts[(n_c+1):(2*n_c)] = (1 - y_vals) .* wi;
+    return starts;
+}
+
+/* ew_poly_series() with the windowed start. */
+vector ew_poly_series_win(real cycle_length, int n_c, real start_window,
+                          real a, real b, real log10_total0, real R, real mu,
+                          int n_obs, array[] real ts, int M, int r_max,
+                          vector lgam, vector r_less1, array[] int r_lo,
+                          array[] int r_hi, array[] int m_lo, array[] int m_hi) {
+    return ew_poly_eval(
+        make_DC_win(cycle_length, n_c, start_window, a, b, log10_total0),
+        n_c, cycle_length, R, mu, n_obs, ts, M, r_max, lgam, r_less1,
+        r_lo, r_hi, m_lo, m_hi);
+}
+
+/*
+ traj_combo_partial_sum() with the windowed start: identical except that
+ the start is one shared (start_window, a, b) instead of per-grp_init
+ b_shape and b_offset. A separate function rather than a branch inside the
+ original, so start_dist = 0 runs byte-identical Stan code.
+*/
+real traj_combo_partial_sum_win(array[] int combo_slice, int start, int end,
+                                data array[] int traj_rep, data array[] int grp_init,
+                                data array[] int grp_cl, data array[] int grp_R,
+                                data array[] int tcombo_start, data array[] int tcombo_len,
+                                data array[] int ocombo_start, data array[] int ocombo_len_fit,
+                                data array[] int ocombo_obs, data array[] int yh_local,
+                                data array[] int grp_sd_obs,
+                                data real start_window, real start_a, real start_b,
+                                vector log10_total0,
+                                int n_c, vector cycle_length, vector R, data real mu,
+                                vector sd_iRBC,
+                                data array[] real u_ts, data vector y_trans,
+                                int M, int r_max, data vector lgam, data vector r_less1,
+                                data array[] int u_r_lo, data array[] int u_r_hi,
+                                data array[] int u_m_lo, data array[] int u_m_hi) {
+    real lp = 0;
+    for (k in 1:size(combo_slice)) {
+        int c = combo_slice[k];
+        int j = traj_rep[c];
+        if (ocombo_len_fit[c] == 0) continue;     // whole combo held out
+        vector[3*n_c - 1] DC_c = make_DC_win(cycle_length[grp_cl[j]], n_c,
+                                             start_window, start_a, start_b,
+                                             log10_total0[grp_init[j]]);
+        int us = tcombo_start[c];
+        int ue = us + tcombo_len[c] - 1;
+        vector[tcombo_len[c]] y_hat_c = ew_poly_eval(
+            DC_c, n_c, cycle_length[grp_cl[j]], R[grp_R[j]], mu,
+            tcombo_len[c], u_ts[us:ue], M, r_max, lgam, r_less1,
+            u_r_lo[us:ue], u_r_hi[us:ue], u_m_lo[us:ue], u_m_hi[us:ue]);
+
+        int os = ocombo_start[c];
+        int oe = os + ocombo_len_fit[c] - 1;
+        array[ocombo_len_fit[c]] int ks = ocombo_obs[os:oe];
+        lp += normal_lpdf(y_trans[ks] | log10(y_hat_c[yh_local[ks]] + 1),
+                          sd_iRBC[grp_sd_obs[ks]]);
+    }
+    return lp;
+}
